# -------------------------------------------------------------------
# Stage 1: Dependency Builder
# -------------------------------------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast wheel resolution
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --no-editable -o requirements.txt && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt

# -------------------------------------------------------------------
# Stage 2: Hardened Runtime Image
# -------------------------------------------------------------------
FROM python:3.12-slim AS runtime

WORKDIR /app

# Install runtime C libraries for ONNX & curl for healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed site-packages from builder
COPY --from=builder /install /usr/local

# Create non-privileged system user without shell access
RUN groupadd -r mlops && useradd -r -g mlops -s /bin/false appuser

# Copy application source, configuration, and model binaries
COPY src/ /app/src/
COPY models/ /app/models/

# Create runtime directories needed for telemetry and metrics
RUN mkdir -p /app/data/inference_logs \
             /app/reports/drift \
             /tmp/prometheus_multiproc && \
    chown -R appuser:mlops /app /tmp/prometheus_multiproc

# Environment Variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    FEAST_REPO_PATH=/app/src/features \
    MODEL_PATH=/app/models/model.onnx \
    PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# Drop privileges to non-root user
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD curl -f http://localhost:8000/healthz || exit 1

CMD ["gunicorn", "-c", "src/serving/gunicorn_conf.py", "src.serving.app:app"]